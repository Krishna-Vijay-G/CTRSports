# Neon Postgres — media posts, admin users, admin sessions
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# AWS S3 — post image uploads
S3_BUCKET=ctr-unified-media-storage
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: CloudFront / custom domain in front of the bucket.
# Leave unset to serve images straight from https://<bucket>.s3.<region>.amazonaws.com
# S3_PUBLIC_BASE_URL=https://media.ctrsports.in
